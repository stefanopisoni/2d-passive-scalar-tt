\@writefile{toc}{\contentsline {section}{\numberline {I}Conventions: what $\chi $, $\epsilon $ and $\rho $ refer to}{1}{section*.3}\protected@file@percent }
\newlabel{sec:conventions}{{I}{1}{}{section*.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces The three symbols by object. The bond cap $\chi $ on $\theta $ is the only quantity swept; the SVD threshold $\epsilon $ on $\theta $ is disabled in the production runs, so truncation is governed by the cap alone; and $\rho $ is measured after the fact.}}{1}{table.1}\protected@file@percent }
\newlabel{tab:symbols}{{I}{1}{The three symbols by object. The bond cap $\chi $ on $\theta $ is the only quantity swept; the SVD threshold $\epsilon $ on $\theta $ is disabled in the production runs, so truncation is governed by the cap alone; and $\rho $ is measured after the fact}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces All $101$ production runs, by family. $\chi (\theta )$ is the swept control and $\rho (\theta )$ the range it produces across the head sizes listed; $\epsilon (\theta )$ is off throughout except in one run of the family marked $^{\dagger }$, where a cap of $128$ was left loose and $\epsilon =10^{-6}$ was allowed to select the bond instead, giving $\chi =61$; the other three runs of that family use caps $16$, $32$ and $64$ with $\epsilon $ off. $\Delta t$ is CFL-limited in every family. $\gamma =1$ for the cellular flow and $14.6$ for the truncated DNS velocity, which is why the two reach a comparable $\ell _B/\Delta x$ at very different $\kappa $.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:runs}{{II}{2}{All $101$ production runs, by family. $\chi (\theta )$ is the swept control and $\rho (\theta )$ the range it produces across the head sizes listed; $\epsilon (\theta )$ is off throughout except in one run of the family marked $^{\dagger }$, where a cap of $128$ was left loose and $\epsilon =10^{-6}$ was allowed to select the bond instead, giving $\chi =61$; the other three runs of that family use caps $16$, $32$ and $64$ with $\epsilon $ off. $\Delta t$ is CFL-limited in every family. $\gamma =1$ for the cellular flow and $14.6$ for the truncated DNS velocity, which is why the two reach a comparable $\ell _B/\Delta x$ at very different $\kappa $}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {II}Setup}{2}{section*.4}\protected@file@percent }
\newlabel{eq:scalar}{{1}{2}{}{equation.1}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Physical histories, all from the dense reference. (a) Variance: monotone decay without forcing; with it, a slow approach to the steady value $0.4804$, still $6\%$ away at $T=60$. (b) The budget of Eq.~\eqref  {eq:budget}, formed numerically: the unforced flows close it to within the line width at every sample, and the forced case approaches closure as the steady state is approached (it is evaluated only at the stored snapshots, since the production $\langle \theta f\rangle $ is not a recorded diagnostic). (c) Where the variance sits: centroid $\bar  k$ and the $95\%$ wavenumber $k_{95}$ both move to small scale and then stall, which is the cascade reaching $\ell _B$. (d) Gradient flatness rises well above the Gaussian value of $3$ as filaments form. (e) The variance spectrum filling in over time. (f) Scalar dissipation, peaking when the cascade arrives at $\ell _B$.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:histphys}{{1}{4}{Physical histories, all from the dense reference. (a) Variance: monotone decay without forcing; with it, a slow approach to the steady value $0.4804$, still $6\%$ away at $T=60$. (b) The budget of Eq.~\eqref {eq:budget}, formed numerically: the unforced flows close it to within the line width at every sample, and the forced case approaches closure as the steady state is approached (it is evaluated only at the stored snapshots, since the production $\langle \theta f\rangle $ is not a recorded diagnostic). (c) Where the variance sits: centroid $\bar k$ and the $95\%$ wavenumber $k_{95}$ both move to small scale and then stall, which is the cascade reaching $\ell _B$. (d) Gradient flatness rises well above the Gaussian value of $3$ as filaments form. (e) The variance spectrum filling in over time. (f) Scalar dissipation, peaking when the cascade arrives at $\ell _B$}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {a}Verified \texttt  {\relax \fontsize  {9}{10.5}\selectfont  \abovedisplayskip 8.5\p@ plus3\p@ minus4\p@ \belowdisplayskip \abovedisplayskip \abovedisplayshortskip \z@ plus2\p@ \belowdisplayshortskip 4\p@ plus2\p@ minus2\p@ \def \leftmargin \leftmargini \parsep 4\p@ plus2\p@ minus\p@ \topsep 8\p@ plus2\p@ minus4\p@ \itemsep 4\p@ plus2\p@ minus\p@ {\leftmargin \leftmargini \topsep 4\p@ plus2\p@ minus2\p@ \parsep 2\p@ plus\p@ minus\p@ \itemsep \parsep }tensnet} traps.}{4}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {V}Histories}{4}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Compression histories at $L=10$, $N=10$, bond cap swept. (a) The error rises while the cascade is generating scales and then saturates; it does not drift. (b) The same curves against the error of merely representing the exact field at that budget, which they track a bounded factor above. (c) Rank: the intrinsic rank of the exact solution at three probe accuracies (solid) plateaus far below the geometric bound, while the rank the solver carries (dotted) sits at its cap throughout, $\epsilon $ being off. (d) Stored parameters, carried versus needed. (e) The variance error, two to four orders of magnitude below the pointwise error at the same budget. (f) Mass drift: truncation is not mass-conserving and no projection is applied, so $|\langle \theta \rangle |$ grows by an amount set by the budget, against $10^{-15}$ for the dense reference.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:histcomp}{{2}{5}{Compression histories at $L=10$, $N=10$, bond cap swept. (a) The error rises while the cascade is generating scales and then saturates; it does not drift. (b) The same curves against the error of merely representing the exact field at that budget, which they track a bounded factor above. (c) Rank: the intrinsic rank of the exact solution at three probe accuracies (solid) plateaus far below the geometric bound, while the rank the solver carries (dotted) sits at its cap throughout, $\epsilon $ being off. (d) Stored parameters, carried versus needed. (e) The variance error, two to four orders of magnitude below the pointwise error at the same budget. (f) Mass drift: truncation is not mass-conserving and no projection is applied, so $|\langle \theta \rangle |$ grows by an amount set by the budget, against $10^{-15}$ for the dense reference}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {VI}Findings and remarks}{5}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {a}The hybrid advantage survives evolution, and is a factor of about two in parameters.}{6}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {b}Representation error predicts evolution error.}{6}{section*.17}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {c}The published compressed fields are plain truncation times a global scalar, confirmed on the data.}{7}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {d}The solver must run single-threaded.}{7}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {e}The forced steady state is a fixed point, reached on a time $\propto 1/\kappa $.}{7}{section*.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Dense approach to the forced steady state against $t$ and against $\kappa t$; the tails collapse in units of $1/\kappa $.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:relax}{{3}{7}{Dense approach to the forced steady state against $t$ and against $\kappa t$; the tails collapse in units of $1/\kappa $}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {f}The hybrid encoding holds the steady state at $512^2$ and $1024^2$; the standard one does not at low $\chi $.}{7}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {g}The rank plateau survives both a sustained forcing and a turbulent velocity.}{7}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {h}With a turbulent velocity the evolution error stops being monotone in the bond cap.}{7}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Forced runs held at the steady state, $512^2$ (top) and $1024^2$ (bottom). Left: $L_2$ error at $t=T$ against $\rho $, evolved (circles) and representation (squares). Centre: steady-variance error. Right: error histories at $\chi =16$, evolved (solid) and representation (dashed).}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:hires}{{4}{8}{Forced runs held at the steady state, $512^2$ (top) and $1024^2$ (bottom). Left: $L_2$ error at $t=T$ against $\rho $, evolved (circles) and representation (squares). Centre: steady-variance error. Right: error histories at $\chi =16$, evolved (solid) and representation (dashed)}{figure.4}{}}
